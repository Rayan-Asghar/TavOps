# ---- Database -------------------------------------------------------
# The app connects as a NOSUPERUSER / NOBYPASSRLS role so the finance RLS
# backstop actually binds. A superuser here would silently disable it.
# Create it with: scripts/bootstrap-roles.sql
DATABASE_URL="postgresql://tavren_app:CHANGE_ME@localhost:5433/tavren_ops"

# Owner role. Used ONLY by drizzle-kit for migrations. Never at runtime.
MIGRATION_DATABASE_URL="postgresql://tavren:tavren_dev_pw@localhost:5433/tavren_ops"

# ---- Auth -----------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# ---- Jobs -----------------------------------------------------------
# Shared secret guarding /api/cron/* so only your scheduler can call them.
CRON_SECRET=""

# Pins the tavren_app password across `pnpm db:reset`. Without it, bootstrap.sh
# reuses whatever password is already in DATABASE_URL, which is usually what
# you want; set this only when scripting a fresh environment.
APP_DB_PASSWORD=""

# ---- Digest delivery ------------------------------------------------
# Comma-separated incoming-webhook URLs for the daily digest. Discord and Slack
# both work; the body shape is chosen per host. Leave blank to disable delivery
# (the digest is still readable at /api/cron/digest?dry=1).
# WhatsApp has no webhook without the Business API — paste the digest there.
DIGEST_WEBHOOK_URLS=""

# ---- Logging --------------------------------------------------------
# debug | info | warn | error. Defaults to info. Structured JSON on stdout.
LOG_LEVEL="info"
