# ---- Database -------------------------------------------------------
# The app connects as a NOSUPERUSER / NOBYPASSRLS role so the finance RLS
# backstop actually binds. A superuser here would silently disable it.
# Create it with: scripts/bootstrap-roles.sql
DATABASE_URL="postgresql://tavren_app:CHANGE_ME@localhost:5433/tavren_ops"

# Connections per process. Ten suits one long-lived Node process; a serverless
# host wants 1, because every concurrent invocation is its own pool and the
# transaction pooler in front is doing the real pooling.
# DATABASE_POOL_MAX=10

# Owner role. Used ONLY by drizzle-kit for migrations. Never at runtime.
MIGRATION_DATABASE_URL="postgresql://tavren:tavren_dev_pw@localhost:5433/tavren_ops"

# ---- Auth -----------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Google sign-in. Optional: leave both blank and the button does not render —
# the password form is unaffected.
#
# These are an OAuth 2.0 *Web application* client, which is NOT the same thing
# as the service account below. The service account writes to Sheets as the app;
# this signs a human in as themselves. Two different credentials, same console.
#
# Create at https://console.cloud.google.com/apis/credentials
#   Authorised JavaScript origin:  http://localhost:3000
#   Authorised redirect URI:       http://localhost:3000/api/auth/callback/google
# and add the production origin and callback before deploying.
#
# Google proves WHO somebody is; it never grants access. An address with no
# matching row in `users` is refused, so accounts are still created by an admin
# under People. Nothing is auto-provisioned.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- Google Sheets (project work-log mirror) ------------------------
# Service account with the Sheets API enabled. Each project's sheet is shared
# with this address as an Editor; nothing syncs until that is done.
# Keep the private key newline-escaped exactly as it comes out of the JSON key.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# The Tavren work-log template. Its /copy link is offered when attaching a
# sheet, so the copy lands in the admin's own Drive rather than the service
# account's — there is no Workspace here, so nothing the service account
# created would have a human owner. Anyone with the link needs read access.
TAVREN_SHEET_TEMPLATE_ID=""

# ---- Jobs -----------------------------------------------------------
# Shared secret guarding /api/cron/* so only your scheduler can call them.
CRON_SECRET=""

# In-app scheduling. "on" (or unset) means the app schedules itself: an open
# browser POSTs /api/heartbeat every few minutes, and the SERVER decides what is
# due from the job_runs table. Five open laptops still produce one run an hour.
# The heartbeat is session-authenticated and never sees CRON_SECRET.
#
# Set to "off" on a host that has real cron hitting /api/cron/*. Both can run at
# once safely -- the cron routes record their runs in the same table, so
# whichever fires first wins and the other finds nothing due -- but there is no
# reason to keep browsers doing it once a scheduler exists.
IN_APP_SCHEDULER="on"

# Pins the tavren_app password across `pnpm db:reset`. Without it, bootstrap.sh
# reuses whatever password is already in DATABASE_URL, which is usually what
# you want; set this only when scripting a fresh environment.
APP_DB_PASSWORD=""

# ---- Digest delivery ------------------------------------------------
# Comma-separated incoming-webhook URLs for the daily digest. Discord and Slack
# both work; the body shape is chosen per host. Leave blank to disable delivery
# (the digest is still readable at /api/cron/digest?dry=1).
# WhatsApp has no webhook without the Business API — paste the digest there.
DIGEST_WEBHOOK_URLS=""

# ---- Logging --------------------------------------------------------
# debug | info | warn | error. Defaults to info. Structured JSON on stdout.
LOG_LEVEL="info"
